// Cloudflare Workers config: static site, plus a small worker for the /admin panel.
{
  "name": "federal-gold",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-07",
  "ai": { "binding": "AI" },
  "kv_namespaces": [{ "binding": "DURUM", "id": "741eca98b480496fa60379aca0b166d9" }],
  "triggers": { "crons": ["17 * * * *"] },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/admin", "/admin/*"]
  }
}

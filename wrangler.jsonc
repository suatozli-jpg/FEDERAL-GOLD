// Cloudflare Workers config: static site, plus a small worker for the /admin panel.
{
  "name": "federal-gold",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-07",
  "ai": { "binding": "AI" },
  "kv_namespaces": [{ "binding": "DURUM", "id": "741eca98b480496fa60379aca0b166d9" }],
  "triggers": { "crons": ["17 * * * *"] },
  // sign-in attempt limits (src/worker.js): per address and for everyone together
  "ratelimits": [
    { "name": "LOGIN_IP", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "LOGIN_ALL", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/admin", "/admin/*"]
  }
}

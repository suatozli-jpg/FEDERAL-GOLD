// Cloudflare Workers config: static site, plus a small worker for the /admin panel.
{
  "name": "federal-gold",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-07",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/admin", "/admin/*"]
  }
}
